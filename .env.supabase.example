# Supabase
# SUPABASE_URL werkt ook zonder NEXT_PUBLIC_-prefix (Vercel waarschuwt daarover).
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Supabase Storage (for scanned invoices) — optional; scans fall back to local files when absent.
# Create a private bucket (default name: "Scans") in Supabase Dashboard > Storage.
# Override with SUPABASE_SCAN_BUCKET if you named it differently.
SUPABASE_SCAN_BUCKET=Scans
