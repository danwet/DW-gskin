# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage (for scanned invoices)
# Create bucket "scanned-invoices" in Supabase Dashboard > Storage
# Set to private, max 15MB, allowed MIME: application/pdf, image/jpeg, image/png