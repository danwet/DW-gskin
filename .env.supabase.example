# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage (for scanned invoices) — optional; scans fall back to local files when absent.
# Create a private bucket named "scanned-invoices" in Supabase Dashboard > Storage.
# Override the bucket name with SUPABASE_SCAN_BUCKET if you use a different one.
# Recommended: private, max 15MB, allowed MIME: application/pdf, image/jpeg, image/png
SUPABASE_SCAN_BUCKET=scanned-invoices
