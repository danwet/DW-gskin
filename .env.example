# Copy to .env.local for local runs, or set these in the Vercel project.

# Auth.js (NextAuth). Google sign-in reads only these.
# Redirect URI to register: {origin}/api/auth/callback/google
# Generate a secret with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional. Auth.js can infer the host locally. Set this in production if needed.
# AUTH_URL=http://localhost:3000

# Required in production so only Vercel Cron can trigger /api/cron/triage
CRON_SECRET=
# Reserved for a future model integration. Unused today.
AGENT_API_KEY=

# --- Mail agent (fase 1) ---
# OpenAI Responses API. Zonder sleutel draait de agent op testdata met een
# deterministische regelclassificatie, zodat de volledige route zonder key werkt.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Mailbron. auto = Gmail als GMAIL_REFRESH_TOKEN + Google OAuth aanwezig zijn,
# anders testdata. Forceer met "fixtures" of "gmail".
MAIL_AGENT_SOURCE=fixtures
# Testdata: 1 = factuur zonder herinnering, 2 = voegt een herinnering toe.
MAIL_AGENT_FIXTURE_STAGE=1

# Live Gmail (achtergrond). Vereist een server-side refresh token van de
# mailbox-eigenaar; de agent leest alleen (Gmail API, read-only scope).
GMAIL_REFRESH_TOKEN=
